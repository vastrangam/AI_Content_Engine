# ── Vastrangam AI Engine · settings ──────────────────────────────────────────
# Copy this file to  .env  and fill in what you have. Everything is optional:
# with an empty file the app still runs, stores your work on this computer and
# asks for your Gemini key in the browser.

# The port your browser opens on.
PORT=3000

# ── Gemini ───────────────────────────────────────────────────────────────────
# Put your key here and it stays on the server — it is never sent to the browser
# and never appears in the page source. Leave it blank to type it in the app.
GEMINI_API_KEY=

# ── Supabase (optional until you have an account) ────────────────────────────
# With these blank the app keeps everything in ./data on this computer.
# Fill them in and the same app stores your work in Supabase instead, so it
# follows you between your laptop and your phone. Nothing else changes.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Who may log in ───────────────────────────────────────────────────────────
# A password for the whole app. Leave blank while you are the only one using it
# on your own machine. Set it before you put the app on the internet.
APP_PASSWORD=
